<?xml version="1.0"?>
<Container version="2">
  <Name>FB-Mod</Name>
  <Repository>ghcr.io/smap-git/fb-mod:4.8.7</Repository>
  <Support>https://github.com/SMAP-git/FB-Mod/issues</Support>
  <Project>https://github.com/SMAP-git/FB-Mod</Project>
  <Icon>https://raw.githubusercontent.com/SMAP-git/FB-Mod/master/packaging/docker/unraid-icon.svg</Icon>
  <Network>bridge</Network>
  <Shell>bash</Shell>
  <Privileged>false</Privileged>
  <Overview>FB-Mod_by_SMAP desktop with TigerVNC and a noVNC browser WebUI. VNC password is optional; use only on a trusted LAN.</Overview>
  <Category>Utility:Tools</Category>
  <WebUI>http://[IP]:[PORT:6081]/vnc.html?autoconnect=true&amp;resize=scale</WebUI>
  <ExtraParams>--user=99:100</ExtraParams>
  <Config Name="VNC Port" Target="5902" Default="5902" Mode="tcp" Description="Native VNC; trusted LAN only." Type="Port" Display="always" Required="true" Mask="false">5902</Config>
  <Config Name="WebUI Port" Target="6081" Default="6081" Mode="tcp" Description="noVNC browser desktop; trusted LAN only." Type="Port" Display="always" Required="true" Mask="false">6081</Config>
  <Config Name="VNC Password" Target="VNC_PASSWORD" Default="" Mode="" Description="6-8 ASCII characters. Empty disables authentication. VNC authentication does not encrypt traffic." Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="Resolution" Target="VNC_GEOMETRY" Default="1440x900" Mode="" Description="Desktop width x height." Type="Variable" Display="advanced" Required="true" Mask="false">1440x900</Config>
  <Config Name="Configuration" Target="/config" Default="/mnt/user/appdata/FB-Mod" Mode="rw" Description="Persistent settings and cache; must be writable by UID 99 / GID 100." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/FB-Mod</Config>
  <Config Name="Media" Target="/media" Default="/mnt/user/Media" Mode="rw" Description="Files to rename; must be writable by UID 99 / GID 100." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/Media</Config>
</Container>
